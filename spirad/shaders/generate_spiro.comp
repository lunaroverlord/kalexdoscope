vec3 rgb2hsv(vec3 c)
{
    vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));

    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

vec3 hsv2rgb(vec3 c)
{
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

ivec2 spirograph(float t)
{
    float x = 0; //(k1 - k2) * cos(t);
    float y = 0; //(k1 - k2) * -sin(t);

    #generate_spirograph

    return ivec2((2 + x)/4*1024, (2 + y)/4*1024); 
}

void main() {
    ivec2 storePos = ivec2(gl_GlobalInvocationID.xy);
    vec4 pixel = vec4(float(storePos.x % 1024) / 1024.0, float(storePos.y % 1024) / 1024.0, 0.0, 1.0);
    float t = (storePos.y * 1024.0 + storePos.x) / (1024.0 * 1024.0) * 2.0 * pi;
    ivec2 xy = spirograph(float(t));

    vec4 rgb1 = vec4(c1, c2, c3, 1.0);
    vec4 rgb2 = vec4(c5, c6, c7, 1.0);
    vec4 rgb = mix(rgb1, rgb2, fract(t / c8));
    //vec3 hsv = rgb2hsv(rgb);

    pixel = c4 * pixel + (1.0 - c4) * rgb;

    imageStore(texture, xy, pixel);
}
